time="2026-05-28 16:26:50" level=ERROR msg="PostGIS(pgx): Prepare, map[string]interface {}{\"err\":(*pgconn.PgError)(0x15cb87992700), \"name\":\"stmtcache_b61e60f014cbfaa1f8472a6424dcd066d369eaac2d0394f6\", \"pid\":0x11f853, \"sql\":\"SELECT ((SELECT ST_AsMVT(q,'result_SY',4096,'geom',NULL) AS data FROM (\\nWITH tile AS (\\n  SELECT ST_TileEnvelope(5, 15, 15) AS env\\n),\\nspatial_filter AS (\\n  SELECT\\n    \\\"fid\\\", \\\"feature_id\\\", \\\"yslx\\\", \\\"ysbm\\\", \\\"zyry\\\", \\\"rq\\\", \\\"bz\\\", \\\"mj\\\", \\\"tbbh\\\", \\\"fclass\\\", \\\"type\\\", \\\"name\\\", \\\"uuid\\\", \\\"biasx\\\", \\\"biasy\\\", \\\"img\\\", \\\"accept_id\\\", \\\"is_current\\\", \\\"status\\\", \\\"version\\\", \\\"created_by\\\", \\\"updated_by\\\", \\\"created_at\\\", \\\"updated_at\\\",\\n    t.geom AS geom_src,\\n    ST_ClipByBox2D(t.geom, box2d(tile.env)) AS g_clip\\n  FROM task_bce5a4dbc485.result_SY t\\n  JOIN tile ON true\\n  WHERE t.geom && tile.env\\n    AND ST_Intersects(t.geom, tile.env)\\n    AND CASE \\n      WHEN 5 <= 12 THEN ST_Area(t.geom) > 1000000.000000  -- 12级以下过滤小几何\\n      ELSE true\\n    END\\n  ORDER BY\\n    CASE\\n      WHEN ST_GeometryType(t.geom) IN ('ST_Point','ST_MultiPoint') THEN 1\\n      ELSE ST_Area(g_clip)\\n    END DESC\\n  LIMIT 50\\n),\\nmvt AS (\\n  SELECT\\n    \\\"fid\\\", \\\"feature_id\\\", \\\"yslx\\\", \\\"ysbm\\\", \\\"zyry\\\", \\\"rq\\\", \\\"bz\\\", \\\"mj\\\", \\\"tbbh\\\", \\\"fclass\\\", \\\"type\\\", \\\"name\\\", \\\"uuid\\\", \\\"biasx\\\", \\\"biasy\\\", \\\"img\\\", \\\"accept_id\\\", \\\"is_current\\\", \\\"status\\\", \\\"version\\\", \\\"created_by\\\", \\\"updated_by\\\", \\\"created_at\\\", \\\"updated_at\\\",\\n    ST_AsMVTGeom(\\n      CASE\\n        WHEN ST_GeometryType(f.g_clip) IN ('ST_Point','ST_MultiPoint') THEN f.g_clip\\n        ELSE ST_SimplifyPreserveTopology(f.g_clip, 1000.000000)\\n      END,\\n      tile.env, 4096, 32, true\\n    ) AS geom,\\n    ST_Area(f.g_clip) AS clip_area,\\n    ST_GeometryType(f.g_clip) AS gtype\\n  FROM spatial_filter f\\n  JOIN tile ON true\\n)\\nSELECT \\\"fid\\\", \\\"feature_id\\\", \\\"yslx\\\", \\\"ysbm\\\", \\\"zyry\\\", \\\"rq\\\", \\\"bz\\\", \\\"mj\\\", \\\"tbbh\\\", \\\"fclass\\\", \\\"type\\\", \\\"name\\\", \\\"uuid\\\", \\\"biasx\\\", \\\"biasy\\\", \\\"img\\\", \\\"accept_id\\\", \\\"is_current\\\", \\\"status\\\", \\\"version\\\", \\\"created_by\\\", \\\"updated_by\\\", \\\"created_at\\\", \\\"updated_at\\\", m.geom\\nFROM mvt m\\nWHERE m.geom IS NOT NULL\\n  AND (\\n    m.gtype IN ('ST_Point','ST_MultiPoint')\\n    OR m.clip_area > 100.000000\\n  )\\n) AS q)) AS data\", \"time\":27243300}"
